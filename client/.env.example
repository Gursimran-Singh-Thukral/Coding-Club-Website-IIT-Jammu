# Copy this file to .env.local (dev) or .env (Docker) and fill in real values.

# Where the browser reaches the Express API. Must always be a URL the
# browser can resolve - never a Docker-internal service name - since it's
# baked into client-side fetches. Update this to your VM's public URL later.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Must match the backend's GOOGLE_CLIENT_ID (same OAuth client, both sides
# verify the same audience).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
