# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on
PORT=5000

# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth client (must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Random long strings - generate with `openssl rand -hex 32`
JWT_SECRET=change-me
REFRESH_SECRET=change-me

# Comma-separated list of origins allowed to call this API with credentials.
# Add your VM's domain here later (e.g. http://localhost:3000,https://club.iitjammu.ac.in)
CLIENT_ORIGIN=http://localhost:3000

# "production" once deployed behind HTTPS - flips cookies to Secure
NODE_ENV=development

# "true" only when running behind a trusted reverse proxy (e.g. nginx on a VM),
# so req.ip reflects the real client instead of the proxy.
TRUST_PROXY=false
